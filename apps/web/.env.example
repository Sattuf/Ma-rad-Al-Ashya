# انسخه إلى .env.local — Copy to apps/web/.env.local.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time: never put secrets here.

# Public URL of the API gateway (include /api/v1). Required for any non-local build.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Stripe publishable key (pk_live_… / pk_test_…). Leave empty to hide online payment.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Real-time messaging (Socket.IO on messaging-service).
NEXT_PUBLIC_SOCKET_URL=http://localhost:3004

# Web push notifications (Firebase). Leave empty to disable push.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Link to the Grafana operations dashboard in the admin sidebar (optional).
NEXT_PUBLIC_GRAFANA_URL=
