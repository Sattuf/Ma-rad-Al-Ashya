# انسخ هذا الملف إلى infra/.env واملأ القيم — Copy to infra/.env and fill in.
# Generate each secret with: openssl rand -base64 48
# Never commit infra/.env (it is git-ignored).

# Shared by all services (same value everywhere)
JWT_ACCESS_SECRET=
# auth-service only, must differ from JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=
# Service-to-service calls
INTERNAL_SECRET=
# identity-service: HMAC secret configured in the Didit dashboard
DIDIT_WEBHOOK_SECRET=
# Prometheus → gateway /metrics (bearer token)
METRICS_TOKEN=
# monitoring profile
GRAFANA_ADMIN_PASSWORD=

# Testing on a real phone: 0.0.0.0 exposes the gateway (3000) and chat (3004) on your
# Wi-Fi network. Leave empty (localhost only) otherwise; use it only on a trusted network.
DEVICE_BIND=
# The gateway as the phone sees it, used in uploaded image URLs, e.g.
# PUBLIC_API_URL=http://192.168.1.20:3000/api/v1 (default http://localhost:3000/api/v1).
PUBLIC_API_URL=

# Optional: payments (promotions). Leave empty to disable.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
