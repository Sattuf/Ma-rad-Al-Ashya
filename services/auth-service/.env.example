# Auth Service — Environment Variables

# Server
SENTRY_DSN=https://example@sentry.io/1234567
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=marad_user
DATABASE_PASSWORD=marad_dev_password
DATABASE_NAME=marad_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:3001/auth/facebook/callback

# Twilio Verify
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-service-sid

# Required: generate with openssl rand -base64 48 (same value in every service)
INTERNAL_SECRET=

# OTP: set to true only in local development (ignored when NODE_ENV=production)
OTP_MOCK_ENABLED=false
# Comma-separated Google OAuth client IDs (web, Android, iOS) accepted for token login
GOOGLE_CLIENT_IDS=
